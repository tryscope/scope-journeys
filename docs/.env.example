# The docs host's own install (the first customer of Journeys is Journeys). Written by
# `npx scope-journeys init` on the deploy; without it the sensor forwards every request
# untouched under the forward-only default and logs one line saying so.
JOURNEYS_INSTALL_ID=jin_your_install_id
JOURNEYS_SALT=
JOURNEYS_API_URL=https://api.tryscope.com
# Only when the project's OIDC federation is off; on Vercel the project's identity is the credential.
JOURNEYS_INSTALL_KEY=
# The host the sensor observes; other hosts (previews) pass through untouched.
JOURNEYS_HOST=journeys.tryscope.com
